# Backend Environment Variables Example
# Port for Express server (Render/Railway/Heroku set PORT automatically)
PORT=5000

# MongoDB Connection String (e.g. MongoDB Atlas cluster or local instance)
# If omitted or unreachable in development, an embedded in-memory MongoDB fallback runs automatically.
MONGODB_URI=mongodb://127.0.0.1:27017/imovies

# JSON Web Token Secret & Expiration
JWT_SECRET=replace_with_a_long_random_secure_secret_for_production
JWT_EXPIRES_IN=7d

# Allowed Client Origin for CORS (e.g. your deployed frontend URL: https://imovies.vercel.app)
# Supports comma-separated origins: https://imovies.vercel.app,http://localhost:5173
CLIENT_URL=http://localhost:5173

# Environment mode ('development' or 'production')
NODE_ENV=development
